# ==========================================
# Quantitative OSINT Blockchain Engine (QOBE)
# Environment Configuration
# ==========================================

# 1. ETHERSCAN_API_KEY (Optional for synthetic/replay mode; Required for live on-chain analysis)
# Get a free key at https://etherscan.io/myapikey
# Used to fetch real transactions and internal contract calls when hitting /analyze?target_wallet=0x...
ETHERSCAN_API_KEY=""

# 2. ANTHROPIC_API_KEY (Optional; falls back to deterministic regex matching if omitted)
# Used by engine/extract.py to run Claude 3.5 Sonnet extraction on unstructured OSINT posts
ANTHROPIC_API_KEY=""

# 3. GEMINI_API_KEY (Optional; for Google AI Studio / Gemini Copilot features)
# Injected automatically in AI Studio / Cloud Run, or paste your Gemini API key here
GEMINI_API_KEY=""

# 4. APP_URL (Default: http://localhost:3000)
# The URL where this applet is hosted
APP_URL="http://localhost:3000"

